@top Journal { item* }

item {
  Transaction |
  PeriodicTransaction |
  AutoPosting |
  AccountDirective |
  CommodityDirective |
  IncludeDirective |
  AliasDirective |
  PayeeDirective |
  TagDirective |
  PriceDirective |
  DefaultCommodityDirective |
  YearDirective |
  DecimalMarkDirective |
  ApplyAccountDirective |
  ApplyYearDirective |
  ApplyTagDirective |
  ApplyFixedDirective |
  AssertDirective |
  CaptureDirective |
  CheckDirective |
  DefineDirective |
  ExprDirective |
  ValueDirective |
  EvalDirective |
  CommodityConversionDirective |
  BucketDirective |
  IgnoredPriceDirective |
  CommandFlagDirective |
  EndDirective |
  BlockComment |
  LineComment |
  BlankLine
}

Transaction {
  TxnHeader Newline
  indentedLine*
}

TxnHeader {
  TxnDate TxnDescription? InlineComment?
}

PeriodicTransaction {
  PeriodicHeader Newline
  indentedLine*
}

PeriodicHeader {
  PeriodicMark PeriodicExpression?
}

AutoPosting {
  AutoHeader Newline
  indentedLine*
}

AutoHeader {
  AutoMark AutoQuery?
}

AccountDirective {
  AccountKeyword DirectiveAccountName InlineComment? Newline
  IndentedComment*
}

CommodityDirective {
  CommodityKeyword DirectiveArgument InlineComment? Newline
  commodityIndentedLine*
}

IncludeDirective {
  IncludeKeyword IncludePath InlineComment? Newline
}

AliasDirective {
  AliasKeyword DirectiveArgument InlineComment? Newline
}

PayeeDirective {
  PayeeKeyword DirectiveArgument InlineComment? Newline
  IndentedComment*
}

TagDirective {
  TagKeyword DirectiveArgument InlineComment? Newline
  IndentedComment*
}

PriceDirective {
  PriceKeyword DirectiveArgument InlineComment? Newline
}

DefaultCommodityDirective {
  DefaultCommodityKeyword DirectiveArgument InlineComment? Newline
}

YearDirective {
  YearKeyword DirectiveArgument InlineComment? Newline
}

DecimalMarkDirective {
  DecimalMarkKeyword DirectiveArgument InlineComment? Newline
}

ApplyAccountDirective {
  ApplyAccountKeyword DirectiveArgument InlineComment? Newline
}

ApplyYearDirective {
  ApplyYearKeyword DirectiveArgument InlineComment? Newline
}

ApplyTagDirective {
  ApplyTagKeyword DirectiveArgument InlineComment? Newline
}

ApplyFixedDirective {
  ApplyFixedKeyword DirectiveArgument InlineComment? Newline
}

AssertDirective {
  AssertKeyword DirectiveRest? Newline
}

CaptureDirective {
  CaptureKeyword DirectiveRest? Newline
}

CheckDirective {
  CheckKeyword DirectiveRest? Newline
}

DefineDirective {
  DefineKeyword DirectiveRest? Newline
}

ExprDirective {
  ExprKeyword DirectiveRest? Newline
}

ValueDirective {
  ValueKeyword DirectiveRest? Newline
}

EvalDirective {
  EvalKeyword DirectiveRest? Newline
}

CommodityConversionDirective {
  CommodityConversionKeyword DirectiveArgument InlineComment? Newline
}

BucketDirective {
  BucketKeyword DirectiveArgument InlineComment? Newline
}

IgnoredPriceDirective {
  IgnoredPriceKeyword DirectiveArgument InlineComment? Newline
}

CommandFlagDirective {
  CommandFlagKeyword DirectiveRest? Newline
}

EndDirective {
  EndKeyword DirectiveArgument? InlineComment? Newline
}

commodityIndentedLine {
  CommodityFormatDirective |
  IndentedComment
}

CommodityFormatDirective {
  PostingIndent FormatKeyword DirectiveArgument InlineComment? Newline
}

indentedLine {
  Posting |
  IndentedComment
}

Posting {
  PostingIndent Status? AccountName Amount? PostingAnnotation* InlineComment? Newline
}

PostingAnnotation {
  CostAnnotation |
  BalanceAssertion |
  LotPrice |
  LotDate
}

Amount {
  Sign? Commodity? Sign? Number Commodity?
}

CostAnnotation {
  CostOp Sign? Commodity? Sign? Number Commodity?
}

BalanceAssertion {
  BalanceOp Sign? Commodity? Sign? Number Commodity?
}

LotPrice {
  ("{{" | "{") LotPriceFixed? Sign? Commodity? Sign? Number Commodity? ("}}" | "}")
}

LotDate {
  "[" LotDateBody "]"
}

IndentedComment {
  CommentIndent CommentMark CommentBody? Newline
}

InlineComment { CommentMark CommentBody? }

@external tokens headerTokens from "./tokens" {
  TxnDate,
  PeriodicMark,
  AutoMark,
  AccountKeyword,
  CommodityKeyword,
  IncludeKeyword,
  AliasKeyword,
  PayeeKeyword,
  TagKeyword,
  PriceKeyword,
  DefaultCommodityKeyword,
  YearKeyword,
  DecimalMarkKeyword,
  ApplyAccountKeyword,
  ApplyYearKeyword,
  ApplyTagKeyword,
  ApplyFixedKeyword,
  AssertKeyword,
  CaptureKeyword,
  CheckKeyword,
  DefineKeyword,
  ExprKeyword,
  ValueKeyword,
  EvalKeyword,
  CommodityConversionKeyword,
  BucketKeyword,
  IgnoredPriceKeyword,
  CommandFlagKeyword,
  EndKeyword,
  BlockComment,
  LineComment,
  BlankLine
}

@external tokens directiveArgTokens from "./tokens" {
  DirectiveAccountName,
  DirectiveArgument,
  DirectiveRest,
  IncludePath,
  TxnDescription,
  PeriodicExpression,
  AutoQuery
}

@external tokens postingTokens from "./tokens" {
  PostingIndent,
  CommentIndent,
  Newline
}

@external tokens accountNameToken from "./tokens" {
  AccountName
}

@external tokens commentBodyToken from "./tokens" {
  CommentBody
}

@external tokens lotDateToken from "./tokens" {
  LotDateBody
}

@tokens {
  Status { "!" | "*" }

  FormatKeyword { "format" }

  Number { @digit (@digit | $[,. ])* @digit | @digit }

  Sign { "+" | "-" }

  Commodity { "\"" !["\n]* "\""
            | $[$€£¥₹₽₿₩₪₺₴₦₡₣₤₧₨]
            | @asciiUppercase (@asciiLetter | @digit | "_")* }

  CostOp { "@@" | "@" }

  BalanceOp { "==" "*"? | "=" "*"? }

  LotPriceFixed { "=" }

  CommentMark { ";" }

  spaces { $[ \t]+ }

  @precedence { CostOp, BalanceOp, Sign, Number, Commodity, Status, CommentMark }
}

@skip { spaces }

@detectDelim
